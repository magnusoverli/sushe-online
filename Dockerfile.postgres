# Keep the official PostgreSQL entrypoint, extensions and data layout. Refresh
# Debian security packages and rebuild gosu with a supported Go toolchain.
FROM golang:1.27.3-trixie@sha256:af1bfc2614ebb1dbd31af514b78740fd678850e76498762b425ecee4c5c6ea80 AS gosu
ARG GOSU_COMMIT=29b939aa5bd4dc588af765b8248f6e39150d2565
ARG SYS_VERSION=v0.49.0
RUN git init /src && cd /src \
    && git remote add origin https://github.com/tianon/gosu.git \
    && git fetch --depth=1 origin "$GOSU_COMMIT" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "$GOSU_COMMIT" \
    && go get golang.org/x/sys@${SYS_VERSION} \
    && go mod verify \
    && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /gosu .

FROM postgres:18.6@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gosu /gosu /usr/local/bin/gosu
RUN gosu nobody true && test "$(gosu postgres id -u)" = "$(id -u postgres)"
LABEL org.opencontainers.image.source="https://github.com/magnusoverli/sushe-online" \
      org.opencontainers.image.description="PostgreSQL 18 with refreshed security packages and gosu"
