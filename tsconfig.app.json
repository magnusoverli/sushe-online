// Structural type-checking for the server tree.
//
// tsconfig.json keeps db/** under the strictest settings we can hold green,
// including noImplicitAny. Applying that bar to the rest of the server would
// mean roughly 3,900 findings, the large majority of them missing parameter
// annotations rather than defects.
//
// This config trades that away: noImplicitAny stays off, so an unannotated
// parameter is simply `any` and reports nothing, while every structural check
// remains on — property access, argument shape, arity, arithmetic operands.
// That is the half that finds real bugs, and it costs about 5% of the strict
// error count over roughly 42k lines.
//
// Both configs run from `npm run typecheck`, so CI enforces both.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "types": ["node"]
  },
  "include": [
    "db/**/*.js",
    "services/**/*.js",
    "routes/**/*.js",
    "middleware/**/*.js",
    "utils/**/*.js",
    "config/**/*.js",
    "templates/**/*.js",
    "index.js",
    "templates.js"
  ],
  "exclude": [
    "node_modules",
    "db/migrations/migrations/**/*.js",
    "src/**",
    "test/**",
    "scripts/**",
    "public/**",
    "browser-extension/**"
  ]
}
