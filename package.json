{
  "name": "sushe-online",
  "version": "2.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=26.10.0 <27",
    "npm": ">=12.1.0 <13"
  },
  "packageManager": "npm@12.1.0",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:js\" \"nodemon --legacy-watch --exitcrash --ignore data/ --ignore '*.log' index.js\"",
    "build": "npm run build:vendor && npm run build:css && npm run build:js",
    "build:vendor": "node scripts/build-vendor-assets.js",
    "build:css": "postcss src/styles/input.css -o public/styles/output.css",
    "build:js": "vite build",
    "package:extension": "node scripts/package-extension.js",
    "watch:css": "postcss src/styles/input.css -o public/styles/output.css --watch",
    "watch:js": "vite build --watch",
    "test": "npm run lint:strict && node scripts/run-tests.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.operations.json --noEmit && tsc -p tsconfig.boundaries.json --noEmit",
    "test:watch": "node --test --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:security": "npm audit --audit-level=moderate",
    "test:security:full": "npm audit && npm outdated",
    "test:all": "npm run lint && npm test && npm run test:security",
    "ci:local": "bash scripts/local-ci.sh",
    "ci:local:e2e": "RUN_E2E=1 bash scripts/local-ci.sh",
    "lint": "eslint .",
    "lint:strict": "npm run format:check:source && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:source": "prettier --check \"*.{js,mjs,json}\" \"{src,test,utils,middleware,routes,db,services,scripts,browser-extension}/**/*.{js,mjs,json,html}\"",
    "migrate": "node scripts/migrate.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:create": "node scripts/migrate.js create",
    "changelog": "node scripts/update-changelog.js",
    "changelog:quick": "node scripts/update-changelog.js",
    "changelog:git": "node scripts/update-changelog.js --git",
    "changelog:setup": "bash scripts/setup-git-hooks.sh",
    "optimize:icons": "bash scripts/optimize-icons.sh",
    "report:maintainability": "node scripts/maintainability-report.js",
    "report:maintainability:json": "node scripts/maintainability-report.js --json",
    "lint:structure:baseline": "node scripts/maintainability-report.js --max-js-files-over-350=79 --max-js-files-over-700=21 --max-legacy-markers=102"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@prometheus-io/client": "^0.16.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "csrf": "^3.1.0",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "emojibase-data": "^17.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-security": "^4.1.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.9",
    "session-file-store": "^1.5.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "core-js": false
  }
}
