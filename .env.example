# Session Configuration
SESSION_SECRET=your-session-secret-here
# Production requires a random secret of at least 32 bytes; placeholders fail startup.
# To rotate, replace the secret and restart all app processes (all sessions expire).

# Email Configuration
# Option 1: Resend (recommended - 3,000 free emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
# For testing without domain verification, use: onboarding@resend.dev

# Option 2: SendGrid (requires paid plan after trial)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# Application Configuration
BASE_URL=http://localhost:3000

# Spotify Integration
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback

# Tidal Integration
TIDAL_CLIENT_ID=your-tidal-client-id
TIDAL_REDIRECT_URI=http://localhost:3000/auth/tidal/callback

# Last.fm Integration
# Get API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_SECRET=your-lastfm-secret

# Claude / Anthropic Integration (album summaries)
# Get an API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxx
# Optional tuning - see README "Claude API Configuration (Album Summaries)"
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_SUMMARY_EFFORT=medium
# CLAUDE_MAX_TOKENS=4096
# CLAUDE_REQUEST_TIMEOUT_MS=120000
# CLAUDE_RATE_LIMIT_MS=500
# CLAUDE_SUMMARY_SENTENCES=5
# CLAUDE_SUMMARY_MIN_SENTENCES=2
# CLAUDE_SUMMARY_MIN_CHARS=250
# CLAUDE_SUMMARY_MAX_CHARS=0
# ALBUM_SUMMARY_CONCURRENCY=3
# ALBUM_SUMMARY_PAGE_SIZE=500

# Production database identities (distinct users, URL-encoded random passwords).
# Use TCP to the private db service; PostgreSQL is not published to the host.
DATABASE_URL=
MIGRATION_DATABASE_URL=
BACKUP_DATABASE_URL=
CONTROL_DATABASE_URL=
RECOVERY_DATABASE_URL=
POSTGRES_ADMIN_PASSWORD=
# One-time setup only: protected backup first for an existing installation.
# PROVISION_DATABASE_URL=
# ADOPT_EXISTING_DATABASE=true
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Existing published Compose installations are adopted automatically by the image.
# These separate-role URLs support explicitly managed deployments and provisioning.
# Development only: DB_AUTO_MIGRATE=true
# MIGRATION_STATEMENT_TIMEOUT_MS=900000
# MIGRATION_LOCK_TIMEOUT_MS=60000
# MIGRATION_DEADLINE_MS=1800000
# RESTORE_MAX_FILE_BYTES=268435456
# RESTORE_TIMEOUT_MS=600000
# RECOVERY_MAX_DATABASE_BYTES=2147483648

# Logging Configuration
LOG_LEVEL=INFO

# Proxy Configuration (Optional - auto-detected in production)
# Set to 1 if behind a single reverse proxy (nginx, cloudflare, docker)
# Set to number of proxies in chain, or specify trusted proxy IPs
# TRUST_PROXY=1

# CORS Configuration (Optional)
# Comma-separated list of explicitly allowed origins.
# Example: ALLOWED_ORIGINS=https://sushe.app,https://admin.sushe.app
# ALLOWED_ORIGINS=
# Strict mode enforces allowlist (while still allowing localhost/private-network/dev extension origins).
# CORS_STRICT_MODE=false

# Admin code logging (Optional)
# Production never logs enrollment codes. Bootstrap the initial admin through provision.
# Non-production only: plaintext (default) or masked.
# ADMIN_CODE_LOG_MODE=masked

# Rate Limiting Configuration (Optional - uses smart defaults)
# Adjust these if you need custom rate limits
# RATE_LIMIT_FORGOT_MAX=5
# RATE_LIMIT_RESET_MAX=5
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_REGISTER_MAX=3
# DISABLE_RATE_LIMITING=false
