{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sushe Historical List Import",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "list", "albums"],
  "properties": {
    "version": {
      "const": 1
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "year"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "year": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999
        }
      }
    },
    "albums": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/album"
      }
    }
  },
  "$defs": {
    "album": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "artist", "album"],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "album": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "comments": {
          "type": ["string", "null"],
          "maxLength": 10000
        },
        "comments_2": {
          "type": ["string", "null"],
          "maxLength": 10000
        },
        "primary_track": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "secondary_track": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "is_disqualified": {
          "type": "boolean",
          "default": false
        },
        "disqualification_reason": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "release_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
        },
        "country": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "genre_1": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "genre_2": {
          "type": ["string", "null"],
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["disqualification_reason"],
            "properties": {
              "disqualification_reason": { "type": "string", "minLength": 1 }
            }
          },
          "then": {
            "required": ["is_disqualified"],
            "properties": {
              "is_disqualified": { "const": true }
            }
          }
        }
      ]
    }
  }
}
